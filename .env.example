# 이 파일을 .env로 복사해 사용한다. .env는 커밋되지 않는다.

# DB 비밀번호는 첫 기동(볼륨 생성) 시점에만 적용된다 — 나중에 바꾸려면 볼륨을 지워야 한다.
DB_PASSWORD=csi_c6_dev
DB_ROOT_PASSWORD=csi_c6_root_dev

# 아래 둘은 비워두면 각각 비활성이다:
#   CSI_TOKEN 비움      → ingest 9600 포트가 인증 없이 열린다
#   ADMIN_PASSWORD 비움 → admin 8180이 인증 없이 열린다 (운용 제어 API 포함)
# 로컬 개발은 비운 채로 무마찰, 외부에 노출되는 배포에서는 반드시 채울 것.
CSI_TOKEN=
ADMIN_PASSWORD=

# Production calibration: 19800 slots (~10 minutes, ~594 windows).
# 축소 시험용으로 240을 쓸 수 있으나, 운용 배포 전에는 반드시 되돌릴 것.
CALIBRATION_SLOTS=19800

# 컨테이너 시간대 — admin의 세션 시각 표시가 이 값을 따른다.
TZ=Asia/Seoul

# 낙상 판정 규칙 — 모델은 창(6초)당 확률만 내고, 확정/기각은 워커가 정한다.
# 재학습·재보정 없이 여기서 조절하고 `docker compose up -d worker`로 반영한다.
#   HOLD: 확률이 임계값을 넘은 뒤, 이 시간만큼 '조용함'이 끊기지 않고 이어지면 낙상 확정
#   WAIT: 이 시간 안에 위 조건을 못 채우면 기각. 반드시 HOLD보다 길게 (권장: HOLD의 2배)
#   MERGE_GAP: 확률이 내려간 뒤 이만큼 조용하면 에피소드를 닫고 기록
# 값을 키우면 오경보가 줄지만, 스스로 금방 일어나는 낙상은 놓친다.
EPISODE_STILLNESS_HOLD_S=30
EPISODE_STILLNESS_WAIT_S=60
EPISODE_MERGE_GAP_S=3
